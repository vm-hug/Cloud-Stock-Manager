# ========================================================
# Cloud Stock Management - Environment Configuration Example
# ========================================================

# Application Environment
NODE_ENV=development
PORT=5001
CORS_ORIGIN=http://localhost:5173

# Database Configuration (PostgreSQL 16)
# Use 'localhost:5432' when running the API directly on the host machine.
# Use 'postgres:5432' when running the API inside a Docker container within the compose network.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cloud_stock_db?schema=public"

# Redis Configuration (Redis 7)
# Use 'localhost:6379' for host machine; 'redis:6379' inside Docker network.
REDIS_URL="redis://localhost:6379"

# Docker Compose Database Credentials
POSTGRES_DB=cloud_stock_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Authentication Secrets (JWT)
# Note: For production, generate cryptographically strong random strings (minimum 32 characters)
JWT_ACCESS_SECRET="example_jwt_access_secret_minimum_32_characters_random"
JWT_REFRESH_SECRET="example_jwt_refresh_secret_minimum_32_characters_random"

# Cloudinary Integration (Product Image Storage)
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# Initial Seed Credentials (Used by prisma/seed.ts)
SEED_ADMIN_EMAIL="admin@cloudstock.dev"
SEED_ADMIN_PASSWORD="AdminPassword123!"
SEED_MANAGER_EMAIL="manager@cloudstock.dev"
SEED_MANAGER_PASSWORD="ManagerPassword123!"
SEED_STAFF_EMAIL="staff@cloudstock.dev"
SEED_STAFF_PASSWORD="StaffPassword123!"
