# ========================================================
# Cloud Stock Management - Environment Configuration Example
# ========================================================
# Copy this file to `.env` at the repository root before running locally.

# Application Environment
NODE_ENV=development # Runtime mode: development | test | production
PORT=5001 # HTTP port for the Express API server
CORS_ORIGIN=http://localhost:5173 # Allowed frontend origin for CORS with credentials

# Database Configuration (PostgreSQL 16)
# Use 'localhost:5432' when running the API directly on the host machine.
# Use 'postgres:5432' when running the API inside a Docker container within the compose network.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cloud_stock_db?schema=public" # Primary PostgreSQL connection URI

# Redis Configuration (Redis 7)
# Use 'localhost:6379' for host machine; 'redis:6379' inside Docker network.
REDIS_URL="redis://localhost:6379" # Redis connection URI used for caching and BullMQ queues

# Docker Compose Database Credentials
POSTGRES_DB=cloud_stock_db # Default database name initialized by Docker Compose
POSTGRES_USER=postgres # PostgreSQL superuser for local Docker container
POSTGRES_PASSWORD=postgres # PostgreSQL password for local Docker container

# Authentication Secrets (JWT)
# Note: For production, generate cryptographically strong random strings (minimum 16 characters; 32+ recommended)
JWT_ACCESS_SECRET="example_jwt_access_secret_minimum_32_characters_random" # Secret key for signing short-lived access tokens
JWT_REFRESH_SECRET="example_jwt_refresh_secret_minimum_32_characters_random" # Secret key for signing refresh tokens

# Cloudinary Integration (Product Image Storage)
# Leave empty in local development if image upload is not being tested.
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name" # Cloudinary cloud identifier
CLOUDINARY_API_KEY="your_cloudinary_api_key" # Cloudinary API key
CLOUDINARY_API_SECRET="your_cloudinary_api_secret" # Cloudinary API secret (keep confidential)

# Initial Seed Credentials (Used by prisma/seed.ts)
SEED_ADMIN_EMAIL="admin@gmail.com" # Default ADMIN account email created during database seeding
SEED_ADMIN_PASSWORD="admin1234@" # Default ADMIN account password (hashed with bcrypt on seed)
SEED_MANAGER_EMAIL="manager@gmail.com" # Default MANAGER account email created during database seeding
SEED_MANAGER_PASSWORD="manager1234@" # Default MANAGER account password (hashed with bcrypt on seed)
SEED_STAFF_EMAIL="minhhung@gmail.com" # Default STAFF account email created during database seeding
SEED_STAFF_PASSWORD="minhhung1234@" # Default STAFF account password (hashed with bcrypt on seed)
